rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'taroret134@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidSiteContent(data) {
      return data.keys().hasAll([
          'brandName',
          'heroKicker',
          'heroTitle',
          'heroDescription',
          'heroCtaLabel',
          'videoUrl',
          'videoTitle',
          'heroPillars',
          'galleryKicker',
          'galleryTitle',
          'galleryDescription',
          'galleryItems',
          'approachKicker',
          'approachTitle',
          'approachDescription',
          'approachItems',
          'contactKicker',
          'contactTitle',
          'contactDescription',
          'contactEmail',
          'contactLocation',
          'footerTagline',
          'footerCopyright',
          'updatedByUid',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'brandName',
          'logoUrl',
          'whatsappWebhookUrl',
          'heroKicker',
          'heroTitle',
          'heroDescription',
          'heroCtaLabel',
          'videoUrl',
          'videoTitle',
          'heroPillars',
          'galleryJumpCtaLabel',
          'ctaLockDelaySeconds',
          'ctaUnlockCooldownSeconds',
          'ctaAdminUnlockEpoch',
          'galleryKicker',
          'galleryTitle',
          'galleryDescription',
          'galleryCategories',
          'galleryItems',
          'approachKicker',
          'approachTitle',
          'approachDescription',
          'approachItems',
          'contactKicker',
          'contactTitle',
          'contactDescription',
          'contactEmail',
          'contactLocation',
          'locationKicker',
          'locationTitle',
          'locationDescription',
          'locationAddress',
          'locationMapsUrl',
          'locationLat',
          'locationLng',
          'footerTagline',
          'footerCopyright',
          'updatedByUid',
          'updatedAt'
        ])
        && data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 80
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 1000 && (data.logoUrl == '' || data.logoUrl.matches('^https?://.+'))))
        && (!('whatsappWebhookUrl' in data) || (data.whatsappWebhookUrl is string && data.whatsappWebhookUrl.size() <= 1000 && (data.whatsappWebhookUrl == '' || data.whatsappWebhookUrl.matches('^https://.+'))))
        && data.heroKicker is string && data.heroKicker.size() <= 120
        && data.heroTitle is string && data.heroTitle.size() >= 1 && data.heroTitle.size() <= 200
        && data.heroDescription is string && data.heroDescription.size() <= 600
        && data.heroCtaLabel is string && data.heroCtaLabel.size() >= 1 && data.heroCtaLabel.size() <= 60
        && data.videoUrl is string && data.videoUrl.size() >= 8 && data.videoUrl.size() <= 1000 && data.videoUrl.matches('^https?://.+')
        && data.videoTitle is string && data.videoTitle.size() <= 200
        && data.heroPillars is list && data.heroPillars.size() <= 6 && (data.heroPillars.size() == 0 || data.heroPillars[0] is map)
        && (!('galleryJumpCtaLabel' in data) || (data.galleryJumpCtaLabel is string && data.galleryJumpCtaLabel.size() <= 100))
        && (!('ctaLockDelaySeconds' in data) || (data.ctaLockDelaySeconds is int && data.ctaLockDelaySeconds >= 5 && data.ctaLockDelaySeconds <= 86400))
        && (!('ctaUnlockCooldownSeconds' in data) || (data.ctaUnlockCooldownSeconds is int && data.ctaUnlockCooldownSeconds >= 10 && data.ctaUnlockCooldownSeconds <= 86400))
        && (!('ctaAdminUnlockEpoch' in data) || (data.ctaAdminUnlockEpoch is int && data.ctaAdminUnlockEpoch >= 0 && data.ctaAdminUnlockEpoch <= 9999999999999))
        && data.galleryKicker is string && data.galleryKicker.size() <= 120
        && data.galleryTitle is string && data.galleryTitle.size() >= 1 && data.galleryTitle.size() <= 200
        && data.galleryDescription is string && data.galleryDescription.size() <= 600
        && (!('galleryCategories' in data) || (data.galleryCategories is list && data.galleryCategories.size() >= 1 && data.galleryCategories.size() <= 20 && data.galleryCategories[0] is string && data.galleryCategories[0].size() >= 1 && data.galleryCategories[0].size() <= 60))
        && data.galleryItems is list && data.galleryItems.size() <= 50 && (data.galleryItems.size() == 0 || data.galleryItems[0] is map)
        && data.approachKicker is string && data.approachKicker.size() <= 120
        && data.approachTitle is string && data.approachTitle.size() >= 1 && data.approachTitle.size() <= 200
        && data.approachDescription is string && data.approachDescription.size() <= 600
        && data.approachItems is list && data.approachItems.size() <= 10 && (data.approachItems.size() == 0 || data.approachItems[0] is map)
        && data.contactKicker is string && data.contactKicker.size() <= 120
        && data.contactTitle is string && data.contactTitle.size() >= 1 && data.contactTitle.size() <= 200
        && data.contactDescription is string && data.contactDescription.size() <= 600
        && data.contactEmail is string && data.contactEmail.size() <= 160
        && data.contactLocation is string && data.contactLocation.size() <= 160
        && (!('locationKicker' in data) || (data.locationKicker is string && data.locationKicker.size() <= 120))
        && (!('locationTitle' in data) || (data.locationTitle is string && data.locationTitle.size() <= 200))
        && (!('locationDescription' in data) || (data.locationDescription is string && data.locationDescription.size() <= 600))
        && (!('locationAddress' in data) || (data.locationAddress is string && data.locationAddress.size() <= 240))
        && (!('locationMapsUrl' in data) || (data.locationMapsUrl is string && data.locationMapsUrl.size() <= 1000 && (data.locationMapsUrl == '' || data.locationMapsUrl.matches('^https://.+'))))
        && (!('locationLat' in data) || (data.locationLat == null || ((data.locationLat is float || data.locationLat is int) && data.locationLat >= -90 && data.locationLat <= 90)))
        && (!('locationLng' in data) || (data.locationLng == null || ((data.locationLng is float || data.locationLng is int) && data.locationLng >= -180 && data.locationLng <= 180)))
        && data.footerTagline is string && data.footerTagline.size() <= 300
        && data.footerCopyright is string && data.footerCopyright.size() <= 120
        && data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 && data.updatedByUid == request.auth.uid
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == adminUid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidRoundRobin(data) {
      return data.keys().hasAll(['turnCount', 'updatedAt'])
        && data.keys().hasOnly(['turnCount', 'updatedAt'])
        && data.turnCount is int
        && data.turnCount >= 1
        && data.turnCount <= 1000000000
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidContactInquiry(data) {
      return data.keys().hasAll([
          'name',
          'email',
          'phone',
          'message',
          'senderWhatsapp',
          'assignedWhatsapp',
          'turnSlot',
          'recipientEmail',
          'emailStatus',
          'dispatched',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'message',
          'senderWhatsapp',
          'assignedWhatsapp',
          'turnSlot',
          'recipientEmail',
          'emailStatus',
          'dispatched',
          'createdAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 40
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 2000
        && data.senderWhatsapp == '+503 60431208'
        && data.assignedWhatsapp in ['+503 61631237', '+503 79007071', '+503 75437670']
        && data.turnSlot is int && data.turnSlot >= 1 && data.turnSlot <= 3
        && data.recipientEmail is string && data.recipientEmail.size() >= 3 && data.recipientEmail.size() <= 160
        && data.emailStatus in ['pending', 'sent', 'activation_required', 'fallback']
        && data.dispatched is bool
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidCtaLock(data) {
      return data.keys().hasAll([
          'deviceKey',
          'firstSeenAtMs',
          'epoch',
          'adminUnlocked',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'deviceKey',
          'firstSeenAtMs',
          'epoch',
          'adminUnlocked',
          'updatedAt'
        ])
        && data.deviceKey is string
        && data.deviceKey.size() >= 4
        && data.deviceKey.size() <= 128
        && data.deviceKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.firstSeenAtMs is int
        && data.firstSeenAtMs >= 1700000000000
        && data.firstSeenAtMs <= 9999999999999
        && data.epoch is int
        && data.epoch >= 0
        && data.epoch <= 9999999999999
        && data.adminUnlocked is bool
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /siteContent/{contentId} {
      allow get: if isValidId(contentId) && contentId == 'main';
      allow list: if false;
      allow create: if isValidId(contentId)
        && contentId == 'main'
        && isAdmin()
        && isValidSiteContent(incoming());
      allow update: if isValidId(contentId)
        && contentId == 'main'
        && isAdmin()
        && isValidSiteContent(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'brandName',
          'logoUrl',
          'whatsappWebhookUrl',
          'heroKicker',
          'heroTitle',
          'heroDescription',
          'heroCtaLabel',
          'videoUrl',
          'videoTitle',
          'heroPillars',
          'galleryJumpCtaLabel',
          'ctaLockDelaySeconds',
          'ctaUnlockCooldownSeconds',
          'ctaAdminUnlockEpoch',
          'galleryKicker',
          'galleryTitle',
          'galleryDescription',
          'galleryCategories',
          'galleryItems',
          'approachKicker',
          'approachTitle',
          'approachDescription',
          'approachItems',
          'contactKicker',
          'contactTitle',
          'contactDescription',
          'contactEmail',
          'contactLocation',
          'locationKicker',
          'locationTitle',
          'locationDescription',
          'locationAddress',
          'locationMapsUrl',
          'locationLat',
          'locationLng',
          'footerTagline',
          'footerCopyright',
          'updatedByUid',
          'updatedAt'
        ]);
      allow delete: if isValidId(contentId) && contentId == 'main' && isAdmin();
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isAdmin();
      allow list: if false;
      allow create: if isValidId(adminUid)
        && isAdmin()
        && isValidAdminRecord(incoming(), adminUid);
      allow update: if false;
      allow delete: if isValidId(adminUid) && isAdmin() && adminUid != request.auth.uid;
    }

    match /contactRouting/{routingId} {
      allow get: if isValidId(routingId) && routingId == 'roundRobin';
      allow list: if false;
      allow create: if isValidId(routingId)
        && routingId == 'roundRobin'
        && isValidRoundRobin(incoming())
        && incoming().turnCount == 1;
      allow update: if isValidId(routingId)
        && routingId == 'roundRobin'
        && isValidRoundRobin(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['turnCount', 'updatedAt'])
        && incoming().turnCount == existing().turnCount + 1;
      allow delete: if isValidId(routingId) && routingId == 'roundRobin' && isAdmin();
    }

    match /contactInquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(inquiryId)
        && isValidContactInquiry(incoming())
        && incoming().dispatched == false;
      allow update: if isValidId(inquiryId)
        && isAdmin()
        && isValidContactInquiry(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['dispatched'])
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    match /ctaLocks/{lockId} {
      allow get: if isValidId(lockId);
      allow list: if isAdmin();
      allow create: if isValidId(lockId)
        && isValidCtaLock(incoming())
        && incoming().deviceKey == lockId
        && incoming().adminUnlocked == false;
      allow update: if isValidId(lockId)
        && isValidCtaLock(incoming())
        && incoming().deviceKey == existing().deviceKey
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'firstSeenAtMs',
          'epoch',
          'adminUnlocked',
          'updatedAt'
        ])
        && (
          isAdmin()
          || (
            incoming().adminUnlocked == false
            && incoming().epoch > existing().epoch
            && exists(/databases/$(database)/documents/siteContent/main)
            && incoming().epoch == get(/databases/$(database)/documents/siteContent/main).data.ctaAdminUnlockEpoch
          )
        );
      allow delete: if isValidId(lockId) && isAdmin();
    }
  }
}
