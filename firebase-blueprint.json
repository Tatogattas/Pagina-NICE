{
  "entities": {
    "SiteContent": {
      "title": "SiteContent",
      "description": "Published landing page copy, embedded external video link, and external gallery items.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "logoUrl": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^$|^https?://.+"
        },
        "whatsappWebhookUrl": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^$|^https://.+"
        },
        "heroKicker": { "type": "string", "maxLength": 120 },
        "heroTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "heroDescription": { "type": "string", "maxLength": 600 },
        "heroCtaLabel": { "type": "string", "minLength": 1, "maxLength": 60 },
        "videoUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1000,
          "pattern": "^https?://.+"
        },
        "videoTitle": { "type": "string", "maxLength": 200 },
        "heroPillars": { "type": "array" },
        "galleryKicker": { "type": "string", "maxLength": 120 },
        "galleryTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "galleryDescription": { "type": "string", "maxLength": 600 },
        "galleryItems": { "type": "array" },
        "approachKicker": { "type": "string", "maxLength": 120 },
        "approachTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "approachDescription": { "type": "string", "maxLength": 600 },
        "approachItems": { "type": "array" },
        "contactKicker": { "type": "string", "maxLength": 120 },
        "contactTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "contactDescription": { "type": "string", "maxLength": 600 },
        "contactEmail": { "type": "string", "maxLength": 160 },
        "contactLocation": { "type": "string", "maxLength": 160 },
        "locationKicker": { "type": "string", "maxLength": 120 },
        "locationTitle": { "type": "string", "maxLength": 200 },
        "locationDescription": { "type": "string", "maxLength": 600 },
        "locationAddress": { "type": "string", "maxLength": 240 },
        "locationMapsUrl": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^$|^https://.+"
        },
        "locationLat": { "type": "number" },
        "locationLng": { "type": "number" },
        "footerTagline": { "type": "string", "maxLength": 300 },
        "footerCopyright": { "type": "string", "maxLength": 120 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "brandName",
        "heroKicker",
        "heroTitle",
        "heroDescription",
        "heroCtaLabel",
        "videoUrl",
        "videoTitle",
        "heroPillars",
        "galleryKicker",
        "galleryTitle",
        "galleryDescription",
        "galleryItems",
        "approachKicker",
        "approachTitle",
        "approachDescription",
        "approachItems",
        "contactKicker",
        "contactTitle",
        "contactDescription",
        "contactEmail",
        "contactLocation",
        "footerTagline",
        "footerCopyright",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized administrator registry entry.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "ContactRouting": {
      "title": "ContactRouting",
      "description": "Round-robin turn counter for distributing incoming WhatsApp inquiries across advisors.",
      "type": "object",
      "properties": {
        "turnCount": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["turnCount", "updatedAt"]
    },
    "ContactInquiry": {
      "title": "ContactInquiry",
      "description": "Submitted public contact form inquiry routed from +503 60431208 to a WhatsApp turn and linked admin email.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 40 },
        "message": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "senderWhatsapp": {
          "type": "string",
          "enum": ["+503 60431208"]
        },
        "assignedWhatsapp": {
          "type": "string",
          "enum": ["+503 61631237", "+503 79007071", "+503 75437670"]
        },
        "turnSlot": { "type": "integer" },
        "recipientEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "emailStatus": {
          "type": "string",
          "enum": ["pending", "sent", "activation_required", "fallback"]
        },
        "dispatched": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "email",
        "phone",
        "message",
        "senderWhatsapp",
        "assignedWhatsapp",
        "turnSlot",
        "recipientEmail",
        "emailStatus",
        "dispatched",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/siteContent/{contentId}": {
      "schema": { "$ref": "#/entities/SiteContent" },
      "description": "Publicly readable published landing page document ('main') writable only by verified administrators."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authorized administrator directory readable and writable only by administrators."
    },
    "/contactRouting/{routingId}": {
      "schema": { "$ref": "#/entities/ContactRouting" },
      "description": "Non-PII sequential turn counter ('roundRobin') for WhatsApp advisor rotation."
    },
    "/contactInquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ContactInquiry" },
      "description": "Private visitor inquiries readable, updatable (dispatched state), and deletable strictly by administrators."
    }
  }
}
